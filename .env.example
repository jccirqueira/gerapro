# GeraPro — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# Na primeira execução o servidor também gera JWT_SECRET e MAIL_ENCRYPTION_KEY
# automaticamente e os grava no .env, caso não estejam definidos.

# Segredo usado para assinar/verificar os tokens JWT (obrigatório em produção).
# Gere um valor aleatório longo, ex.: openssl rand -hex 48
JWT_SECRET=

# Chave de criptografia das senhas SMTP / API keys de e-mail gravadas no banco.
# Atenção: rotacionar esta chave exige reentrar as senhas de e-mail na interface.
MAIL_ENCRYPTION_KEY=

# Porta do servidor HTTP (padrão: 8082)
PORT=8082

# Diretório base onde as pastas GeraPro/<empresa>/PTC-* são armazenadas.
# Padrão (recomendado em produção): /caminho/para/dados
# Sem definição, o comportamento legado é usada: <pasta do projeto>/../..
GERAPRO_DATA_DIR=

# Ambiente: development | production
# Em production, o servidor se recusa a iniciar sem JWT_SECRET persistível.
NODE_ENV=development

# === IA (opcional — valores do banco prevalecem sobre estes) ===
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_URL=http://localhost:11434
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Telegram (opcional) ===
TELEGRAM_BOT_TOKEN=
